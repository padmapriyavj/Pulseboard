KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=pulseboard-processor
KAFKA_CLIENT_ID=kafka-processor

# Re-query DB for sensor topics and re-subscribe to Kafka (ms). Must be <60s for “quick” discovery.
KAFKA_TOPIC_REFRESH_INTERVAL_MS=30000

PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=pulseboard
PG_USER=postgres
PG_PASSWORD=admin
